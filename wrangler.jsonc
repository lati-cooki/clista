{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clista-ai-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-15",
  // Serve the Worker at app.clista.ai. custom_domain:true makes `wrangler deploy`
  // create the DNS record + cert automatically (the clista.ai zone is already in
  // the account; the *.clista.ai wildcard cert covers it). Safe to deploy without
  // a route first — comment this out for a *.workers.dev-only smoke deploy.
  "routes": [{ "pattern": "app.clista.ai", "custom_domain": true }],
  // Engine ported to js-sha256 + Web Crypto; no Node builtins, so no nodejs_compat.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "ThreadDO" },
      { "name": "INDEX", "class_name": "IndexDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThreadDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["IndexDO"]
    }
  ],
  "observability": { "enabled": true },
  // Phase 4 identity. Production reads identity from Cloudflare Access: set these
  // to your Access team domain (the "<team>" in <team>.cloudflareaccess.com) and
  // the Access application's AUD tag. Local dev uses DEV_IDENTITY in .dev.vars
  // instead (see .dev.vars.example) — never enable DEV_IDENTITY in production.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "laticooki",
    "ACCESS_AUD": "60455fe3334e5242cb0fe8787064ee31e26e209fed6fe2de2f97c52da5b1cb93",
    // Optional friendly names for agent service tokens (Cloudflare puts the
    // Client ID in the JWT, not the dashboard name). Format: "<clientId>:<name>".
    "AGENT_NAMES": "398a39a665f1d0faeee372da7b67e360:clistahermes",
    // Public intake (POST /api/intake): the comma-separated origin allow-list for
    // CORS — the gate.clista.ai submission form posts cross-origin to the app.
    // The Turnstile SECRET is NOT here (it's a secret): set it with
    //   echo <secret> | npx wrangler secret put TURNSTILE_SECRET
    // When TURNSTILE_SECRET is unset (local dev / tests), verification is skipped
    // so the route is drivable without a token; production always sets it.
    "INTAKE_ALLOWED_ORIGIN": "https://gate.clista.ai"
  }
}
