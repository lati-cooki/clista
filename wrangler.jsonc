{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clista-ai-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-15",
  // Engine ported to js-sha256 + Web Crypto; no Node builtins, so no nodejs_compat.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "THREAD", "class_name": "ThreadDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThreadDO"]
    }
  ],
  "observability": { "enabled": true }
}
