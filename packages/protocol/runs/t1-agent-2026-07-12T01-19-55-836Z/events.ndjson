onfig and a CI job that fails builds on known CVEs, making stale pins a merge-blocking condition rather than a silent risk."},{"citedEventHashes":["sha256:a6f287617bd5288f2177dcb8c0ae46b416eb29d7ca3316e127461f440c2df364"],"text":"the checker approved on review"},{"citedEventHashes":["sha256:514327b4d6ee91d667f8de10c3b4b027b707a8188cf1c21782444794c02b0a23","sha256:a6f287617bd5288f2177dcb8c0ae46b416eb29d7ca3316e127461f440c2df364"],"text":"the maker merged the decision: Adopt the exact-pin committed lockfile, but only landed together with automated update PRs and a CVE-audit CI gate in the same change."}],"id":"rpt_t1_mrh3w4hm_bed02125","object":"sealedReport","renderedAt":"2026-07-12T01:19:55.834Z","renderedByParticipantId":"par_t1_maker","renderingRuleVersion":"clista.report_rendering.v0","threadId":"thd_sealed_run_mrh3w4h9_d5d01472"}},"previous_hash":"sha256:514327b4d6ee91d667f8de10c3b4b027b707a8188cf1c21782444794c02b0a23","protocol_version":"clista.protocol.v0","thread_id":"thd_sealed_run_mrh3w4h9_d5d01472","timestamp":"2026-07-12T01:19:55.834Z"}
