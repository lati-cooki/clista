{
  "name": "clista-ai-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The live ClisTa Protocol cockpit — app.clista.ai",
  "scripts": {
    "generate:examples": "node scripts/generate-examples.mjs",
    "predev": "npm run generate:examples",
    "dev": "vite",
    "prebuild": "npm run generate:examples",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run generate:examples",
    "test": "node --test 'test/*.test.js'",
    "pretest:workers": "npm run generate:examples",
    "test:workers": "vitest run",
    "test:all": "npm test && npm run test:workers"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}
